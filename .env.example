# MedJourney Platform Admin — server-only configuration
# Copy to .env.local for local development. Set the same keys in Vercel
# Project Settings → Environment Variables for production.
# Never use NEXT_PUBLIC_ for passwords or session secrets.

# Private admin URL segment (no leading slash). Example public URL: /medmatch-control
MEDMATCH_ADMIN_ROUTE=medmatch-control

# Demo Owner account (server-only)
MEDMATCH_OWNER_EMAIL=owner@medmatch.sa
MEDMATCH_OWNER_NAME=MedJourney Owner
# Prototype demo password (also prefilled on the admin sign-in form)
MEDMATCH_OWNER_PASSWORD=DemoOwner123!

# Session signing secret (min 32 characters)
MEDMATCH_ADMIN_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Session idle timeout (minutes)
MEDMATCH_ADMIN_SESSION_IDLE_MINUTES=30

# Failed login protection
MEDMATCH_ADMIN_MAX_FAILED_ATTEMPTS=5
MEDMATCH_ADMIN_LOCKOUT_MINUTES=15
